---
import Container from '@components/ui/Container.astro';
import { getButtonClasses } from '@components/ui/Button.tsx';
import Icon from '@components/ui/Icon.astro';
---

<section class="section-padding overflow-x-hidden" aria-label="Sesiones online">
  <Container width="narrow">
    <p class="eyebrow mb-4 text-center">Sesiones online</p>

    <div class="mt-10 grid sm:grid-cols-2 gap-8 text-center">
      <div class="rounded-2xl border border-surface-container-high bg-surface p-8">
        <Icon name="hourglass" size="lg" class="mb-3 text-primary" />
        <p class="text-3xl font-heading text-on-surface">90 Min</p>
      </div>

      <div class="rounded-2xl border border-surface-container-high bg-surface p-8">
        <Icon name="dollar" size="lg" class="mb-3 text-primary" />
        <p class="text-3xl font-heading text-on-surface">35.000 ARS</p>
      </div>
    </div>

    <div class="mt-10 text-center">
      <p class="eyebrow mb-3">¿Qué incluye la sesión?</p>
      <p class="text-on-surface-variant leading-relaxed max-w-2xl mx-auto">
        La sesión se realiza por videollamada e incluye un acompañamiento personalizado, un espacio de escucha confidencial y herramientas para continuar tu proceso.
      </p>
    </div>

    <div class="mt-10 text-center">
      <a
        href="/sesiones-online"
        class={getButtonClasses({ variant: 'primary', size: 'lg' })}
      >
        Agendar sesión
        <Icon name="arrow-right" size="sm" />
      </a>
    </div>
  </Container>
</section>

---
import Container from '@components/ui/Container.astro';
import SectionTitle from '@components/ui/SectionTitle.astro';
import { getButtonClasses } from '@components/ui/Button.tsx';
import Icon from '@components/ui/Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  cta: { label: string; href: string };
  variant?: 'default' | 'accent';
  watermark?: boolean;
}
---

<section
  class:list={[
    'section-padding',
    Astro.props.variant === 'accent' ? 'bg-surface-container-low' : '',
    Astro.props.watermark ? 'relative overflow-hidden' : '',
  ]}
>
  {Astro.props.watermark && (
    <img
      src="/iso_logo.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 m-auto w-72 h-72 sm:w-[28rem] sm:h-[28rem] object-contain opacity-[0.07] select-none pointer-events-none"
    />
  )}
  <Container class="relative z-10">
    <div class="text-center max-w-2xl mx-auto">
      <SectionTitle
        eyebrow={Astro.props.eyebrow}
        title={Astro.props.title}
        subtitle={Astro.props.subtitle}
      />
      <div class="mt-8">
        <a
          href={Astro.props.cta.href}
          class={getButtonClasses({ variant: 'primary', size: 'lg' })}
        >
          {Astro.props.cta.label}
          <Icon name="arrow-right" size="sm" />
        </a>
      </div>
    </div>
  </Container>
</section>
